# ═══════════════════════════════════════════════════════════════════════════
#  Rosetta — Variables d'environnement
#  Copier ce fichier en .env et renseigner les valeurs réelles.
#  Le fichier .env est dans .gitignore — ne jamais le committer.
# ═══════════════════════════════════════════════════════════════════════════

# ── [OBLIGATOIRE] Clé API Anthropic (Claude) ────────────────────────────────
# Obtenir sur : https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-api03-REMPLACER_PAR_CLE_REELLE

# ── [OPTIONNEL] Modèle LLM par défaut ───────────────────────────────────────
# Valeur par défaut : claude-sonnet-4-6
# ROSETTA_DEFAULT_MODEL=claude-sonnet-4-6

# ── [OPTIONNEL] Chemins opérationnels ───────────────────────────────────────
# Valeur par défaut : ~/rosetta-data/kb
# ROSETTA_KB=~/rosetta-data/kb

# Répertoire des archives d'audit — par défaut : ~/rosetta-memory
# ROSETTA_MEMORY=~/rosetta-memory

# Fichier de métriques ROI (JSONL) — par défaut : ~/rosetta-data/roi_metrics.jsonl
# ROSETTA_TELEMETRY=~/rosetta-data/roi_metrics.jsonl

# ── [OPTIONNEL] Google Cloud (si usage Gemini / Vertex AI) ──────────────────
# GOOGLE_API_KEY=AIzaSy-REMPLACER_PAR_CLE_REELLE
# GOOGLE_APPLICATION_CREDENTIALS=/home/user/.config/gcloud/application_default_credentials.json
# GOOGLE_CLOUD_PROJECT=mon-projet-gcp
# GOOGLE_CLOUD_LOCATION=us-central1
